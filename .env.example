# Required for the pipelines and dashboard
DATABASE_URL=postgresql://localhost:5432/job_bot

# Required for LLM filtering and scoring
GROQ_API_KEY=

# Optional notifications
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOKEN_ALERT=
TELEGRAM_CHAT_ID_ALERT=

# Required to open the dashboard, including locally
DASHBOARD_PASSWORD=

# Optional manual workflow trigger from the dashboard (your own repository)
GH_WORKFLOW_TOKEN=
GH_WORKFLOW_REPOSITORY=
GH_WORKFLOW_REF=main

# Keep candidate details private. Use either inline text or local file paths.
PROFILE_FACTUEL_FILE=.local/profile_factuel.md
PROFILE_MOTIVATIONNEL_FILE=.local/profile_motivationnel.md
# PROFILE_FACTUEL=
# PROFILE_MOTIVATIONNEL=
